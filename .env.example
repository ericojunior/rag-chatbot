## LLM (opcional) — escolha um provedor
# Provedor: "deepseek" ou "openai"
LLM_PROVIDER=deepseek

# Recomendado: chave no padrão genérico
LLM_API_KEY=

# Base URL (DeepSeek tipicamente funciona assim; para OpenAI use https://api.openai.com/v1)
LLM_BASE_URL=https://api.deepseek.com/v1

# Modelos comuns:
# - deepseek-chat
# - deepseek-reasoner (se disponível na sua conta)
LLM_MODEL=deepseek-chat

## Compatibilidade (legado) — se preferir, você pode usar estas variáveis em vez das acima:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

## Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
